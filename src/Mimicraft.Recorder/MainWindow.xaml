<Window x:Class="Mimicraft.Recorder.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Mimicraft Recorder" Width="1180" Height="790" MinWidth="1000" MinHeight="680" WindowStartupLocation="CenterScreen" AutomationProperties.AutomationId="MainWindow">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="208"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#203F35"><Grid Margin="24,32"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Mimicraft." FontSize="28" Foreground="#F5F4E8" FontWeight="Bold"/><TextBlock Text="RECORDER / 录制工作台" Foreground="#AFC7B7" FontSize="11" Margin="0,10,0,42"/><Border Background="#39574A" Padding="17,14" CornerRadius="8"><TextBlock Text="◉   本地录制" Foreground="White" FontSize="15"/></Border><ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="390"><StackPanel x:Name="SideTools" Margin="0,8,0,0"><StackPanel.Resources><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="8,7"/><Setter Property="FontSize" Value="12"/></Style></StackPanel.Resources></StackPanel></ScrollViewer><TextBlock Text="录制 · 整理 · 带走" Foreground="#9AB5A3" Margin="15,20,0,0" FontSize="12"/></StackPanel><StackPanel Grid.Row="2"><TextBlock Text="专注记录眼前的内容。" Foreground="#CFDCCF" FontSize="12"/><TextBlock Text="R3 本地预览 · 全部功能免费" Foreground="#8AA693" FontSize="10" Margin="0,10,0,0"/></StackPanel></Grid></Border>
  <Grid Grid.Column="1" Margin="32,28,32,22">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,24"><StackPanel><TextBlock Text="留住这一段。" FontSize="29" FontWeight="Bold"/><TextBlock Text="在本机录制，完成后保存在自己的电脑。" Foreground="#7A8878" Margin="0,8,0,0"/></StackPanel><Border DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#E7EDE0" CornerRadius="15" Padding="13,7"><TextBlock Text="{Binding ActivityHint}" Foreground="#55724F" FontSize="11"/></Border></DockPanel>
   <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="256"/></Grid.ColumnDefinitions>
    <Grid Margin="0,0,22,0"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="200"/></Grid.RowDefinitions>
     <Border Background="#E9EEE3" CornerRadius="12" BorderBrush="#DCE4D6" BorderThickness="1" Padding="18"><Grid><Image Source="{Binding Preview}" Stretch="Uniform" AutomationProperties.AutomationId="CapturePreview"/><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding PlaceholderVisibility}"><TextBlock Text="◎" FontSize="64" HorizontalAlignment="Center" Foreground="#7E9C7E"/><TextBlock Text="准备好，就从这里开始" FontSize="20" Margin="0,16,0,9" HorizontalAlignment="Center"/><TextBlock Text="点击“练习画面”，可先录一段无声演示。" Foreground="#85917B" FontSize="12"/></StackPanel><Border Background="#EFFFF9" CornerRadius="5" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="10,5"><TextBlock Text="画面预览 / SDR" FontSize="10" Foreground="#4C7055"/></Border></Grid></Border>
     <Grid Grid.Row="1" Margin="0,22,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel><TextBlock Text="最近录制" FontSize="16" FontWeight="SemiBold"/><Button Content="刷新" DockPanel.Dock="Right" HorizontalAlignment="Right" Command="{Binding RefreshCommand}" Padding="10,3" Margin="0"/></DockPanel><ListBox Grid.Row="1" Margin="0,10,0,0" ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}" BorderThickness="0" Background="Transparent" AutomationProperties.AutomationId="RecordingList"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="3,5"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Summary}" FontSize="10" Foreground="#7A8878" Margin="0,5,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></Grid>
    </Grid>
    <Border Grid.Column="1" Background="White" BorderBrush="#DCE3D6" BorderThickness="1" CornerRadius="12" Padding="20"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="录制设置" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,12"/><Border Background="#F0F5EB" Padding="10" CornerRadius="7" Margin="0,0,0,12"><StackPanel><TextBlock Text="{Binding CaptureRangeLabel}" TextWrapping="Wrap" FontSize="12" AutomationProperties.AutomationId="CaptureRangeStatus"/><Button Content="{Binding ResetRangeLabel}" Click="ResetRegion_Click" IsEnabled="{Binding CanConfigure}" Margin="0,8,0,0" Padding="8,6" ToolTip="清除选区，恢复当前显示器或窗口的完整画面。录制中请先停止。" AutomationProperties.AutomationId="ResetRegionButton"/></StackPanel></Border><TextBlock Text="{Binding CameraRecordingLabel}" TextWrapping="Wrap" FontSize="11" AutomationProperties.AutomationId="CameraRecordingStatus"/><Button Content="设置摄像头画中画" Click="CameraSettings_Click" IsEnabled="{Binding CanConfigure}" Margin="0,8,0,14" Padding="8,7" AutomationProperties.AutomationId="PrimaryCameraSettings"/><TextBlock Text="画面来源" FontSize="11" Foreground="#7C8978"/><ComboBox ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}" DisplayMemberPath="Name" IsEnabled="{Binding CanConfigure}" AutomationProperties.AutomationId="SourceSelect"/><Button Content="打开练习画面" Command="{Binding PracticeCommand}" Margin="0,0,0,20" AutomationProperties.AutomationId="PracticeButton"/><TextBlock Text="输出分辨率" FontSize="11" Foreground="#7C8978"/><ComboBox ItemsSource="{Binding Resolutions}" SelectedItem="{Binding Resolution}" IsEnabled="{Binding CanConfigure}" AutomationProperties.AutomationId="ResolutionSelect"/><TextBlock Text="每秒帧数" FontSize="11" Foreground="#7C8978"/><ComboBox ItemsSource="{Binding FrameRates}" SelectedItem="{Binding Fps}" IsEnabled="{Binding CanConfigure}" AutomationProperties.AutomationId="FpsSelect"/><TextBlock Text="编码器" FontSize="11" Foreground="#7C8978"/><ComboBox ItemsSource="{Binding Encoders}" SelectedItem="{Binding Encoder}" IsEnabled="{Binding CanConfigure}" AutomationProperties.AutomationId="EncoderSelect"/><Border Background="#F5F7EF" Padding="12" CornerRadius="7" Margin="0,4,0,18"><TextBlock Text="选区仅在本次打开中有效；重新打开默认整屏。声音可在左侧配置。" TextWrapping="Wrap" FontSize="11" Foreground="#748369" LineHeight="20"/></Border><Button Content="取消等待 / 预约" Command="{Binding CancelWaitCommand}" ToolTip="只取消开始前的倒数或尚未执行的预约，不会停止正在进行的录制。无等待任务时不可用。" Margin="0,0,0,10" AutomationProperties.AutomationId="CancelWait"/><Button Content="打开输出目录" Command="{Binding OpenFolderCommand}" Margin="0,0,0,10" AutomationProperties.AutomationId="OpenFolderButton"/><Button Content="静音播放选中视频" Command="{Binding PlayCommand}" Margin="0,0,0,10" AutomationProperties.AutomationId="PlayButton"/><TextBlock Text="{Binding OutputDirectory}" FontSize="10" TextWrapping="Wrap" Foreground="#8D9787"/></StackPanel></ScrollViewer></Border>
   </Grid>
   <Border Grid.Row="2" BorderBrush="#D8DFD0" BorderThickness="0,1,0,0" Padding="0,20,0,0" Margin="0,22,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Elapsed}" FontFamily="Consolas" FontSize="29" AutomationProperties.AutomationId="ElapsedTime"/><TextBlock Text="{Binding StateLabel}" Margin="18,8,0,0" Foreground="#63865B" AutomationProperties.AutomationId="RecordingStatus"/></StackPanel><TextBlock Text="{Binding Status}" Foreground="#7C8876" FontSize="11" Margin="0,6,15,0" TextWrapping="Wrap" MaxWidth="510" AutomationProperties.AutomationId="StatusMessage"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="{Binding PauseLabel}" Command="{Binding PauseCommand}" AutomationProperties.AutomationId="PauseButton" Padding="9,7"/><Button Content="■  停止" Command="{Binding StopCommand}" AutomationProperties.AutomationId="StopButton"/><Button Content="{Binding StartLabel}" Command="{Binding StartCommand}" Background="#35614F" Foreground="White" BorderBrush="#35614F" Margin="0" AutomationProperties.AutomationId="StartButton"/></StackPanel></Grid></Border>
  </Grid>
 </Grid>
</Window>
